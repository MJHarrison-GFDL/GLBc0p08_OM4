<experiment name="GLBc0p08_jra_A01" inherit="MOM6_SIS2_$(FMS_GIT_TAG)_exec">
  <description>

Baseline JRA55-do forced experiments.
CIOD timestepping. NO ICEBERGS.

  </description>
  <input>
      <namelist name="xgrid_nml">
        make_exchange_reproduce = .true.
        interp_method = 'second_order'
      </namelist>
      <namelist name="coupler_nml">
        months = $months,
        days   = $days,
        current_date = 1958,1,1,0,0,0,
        calendar = 'julian',
        dt_atmos =1200,
        dt_cpld = 1200,
        use_lag_fluxes=.false.
        concurrent = .false.
        do_ocean = .true.,
        ocean_npes = $ocn_ranks,
        atmos_npes = $atm_ranks,
        do_atmos = .false.,
        do_land = .false.,
        do_ice = .true.,
        concurrent_ice=.true.
        slow_ice_with_ocean = .true.
        combined_ice_and_ocean = .true.
        check_stocks=0
      </namelist>
      <namelist name="ice_ocean_driver_nml">
        output_directory = './',
        parameter_filename = 'INPUT/CIOD_input','INPUT/CIOD_override'
      </namelist>
      <namelist name="atmos_model_nml">
      </namelist>
      <namelist name="fms_nml">
        clock_grain='ROUTINE'
        clock_flags='NONE'
        domains_stack_size = 8000000
        stack_size =0
      </namelist>
      <namelist name="fms_io_nml">
        threading_read  = 'multi',
        max_files_r = 100,
        max_files_w = 100,
        checksum_required =.false.
     </namelist>
      <namelist name="time_interp_external_nml">
        num_io_buffers=24
      </namelist>
      <namelist name="diag_manager_nml">
        max_files = 100
        flush_nc_files=.false.
        max_axes = 100
        max_num_axis_sets = 100
        max_input_fields = 699
        max_output_fields = 699
        mix_snapshot_average_fields=.false.
        issue_oor_warnings=.false.
      </namelist>
      <namelist name="icebergs_nml">
        verbose=.false.
        verbose_hrs=24
        traj_sample_hrs=24
        debug=.false.
        really_debug=.false.
        use_operator_splitting=.TRUE.
        bergy_bit_erosion_fraction=0.0
        sicn_shift=0.1
        parallel_reprod=.TRUE.
        use_slow_find=.true.
        add_weight_to_ocean=.false.
        passive_mode=.false.
        generate_test_icebergs=.false.
        speed_limit=0.
        use_roundoff_fix=.true.
        make_calving_reproduce=.true.
        tidal_drift=0.005
        coastal_drift=0.001
        mass_scaling = 4000,400,100,40,20,10,4,2,2,2
        force_all_pes_traj=.true.
      </namelist>
      <namelist name="monin_obukhov_nml">
        neutral = .false.,
        stable_option =  2,
        rich_crit = 10.0,
        zeta_trans =  0.5
      </namelist>
      <namelist name="ocean_albedo_nml">
        ocean_albedo_option = 2
      </namelist>
      <namelist name="ocean_rough_nml">
        rough_scheme = 'beljaars'
        roughness_min = 1.e-4
      </namelist>
      <namelist name="surface_flux_nml">
        gust_min = 1.e-10
      </namelist>
      <namelist name="sat_vapor_pres_nml">
        construct_table_wrt_liq = .true.
        construct_table_wrt_liq_and_ice = .true.
        use_exact_qs = .true.
      </namelist>
